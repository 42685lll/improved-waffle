<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/hoshino_blue_dark" />
            <stroke android:width="2dp" android:color="@color/wave_active" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/hoshino_blue" />
            <stroke android:width="2dp" android:color="@color/hoshino_blue_dark" />
        </shape>
    </item>
</selector>
